{
  // Config files (root and per package) and the e2e tests. None of it is
  // published, so it stays out of the packages' isolatedDeclarations configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // All of it runs in Node: configs, and the Playwright test runner.
    "types": ["node"],
    // Scripts Node runs directly (e2e/build-adapters.ts) import with `.ts`.
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "e2e/harness/*.config.ts",
    "e2e",
    "scripts",
    "bench/click-to-paint",
    "docs/diagrams"
  ],
  // The harness page and the adapter fixtures have their own DOM tsconfigs.
  // The harness build copies the devtools panel's source as an asset (its
  // default `new URL('./panel.js', import.meta.url)`), so its output stays out.
  "exclude": [
    "e2e/harness/src",
    "e2e/harness/dist",
    "e2e/isolates/adapters",
    "e2e/isolates/loops",
    // The guides' fence app declares globals for the fences; docs:check checks it with them.
    "scripts/docs/fence-app"
  ]
}
