{
  // Config files (root and per package) and the e2e tests. None of it is
  // published, so it stays out of the packages' isolatedDeclarations configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // All of it runs in Node: configs, and the Playwright test runner.
    "types": ["node"],
    // Scripts Node runs directly (e2e/build-adapters.ts) import with `.ts`.
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "examples/*/*.config.ts",
    "e2e/harness/*.config.ts",
    "e2e",
    "bench/click-to-paint"
  ],
  // The harness page and the adapter fixtures have their own DOM tsconfigs.
  "exclude": ["e2e/harness/src", "e2e/isolates/adapters"]
}
