{
  // Type-checks the fixture against @types/react; the build pins each major.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "typeRoots": ["../../../../packages/react/node_modules/@types"],
    "types": ["react", "react-dom"],
    "paths": {
      "react": ["../../../../packages/react/node_modules/@types/react"],
      "react/*": ["../../../../packages/react/node_modules/@types/react/*"],
      "@isoloop/react": ["../../../../packages/react/src/index.ts"],
      "@isoloop/protocol": ["../../../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["."]
}
