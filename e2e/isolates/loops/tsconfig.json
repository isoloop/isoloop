{
  // Type-checks the fixtures against the newest majors; e2e/build-adapters.ts pins them.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // P and R: React's JSX by default, Preact's where a file asks for it.
    "jsx": "react-jsx",
    "paths": {
      "preact": ["../../../packages/preact/node_modules/preact11"],
      "preact/*": ["../../../packages/preact/node_modules/preact11/*"],
      "react": ["../../../packages/react/node_modules/@types/react"],
      "react/*": ["../../../packages/react/node_modules/@types/react/*"]
    }
  },
  "include": ["."]
}
