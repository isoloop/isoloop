{
  "name": "@isoloop/runtime",
  "version": "0.1.1",
  "description": "The Isoloop runtime: write a part of your app as an isolate in a worker, with a UI or headless, in plain TypeScript.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "microfrontends"
  ],
  "homepage": "https://isoloop.dev/docs/api/runtime/",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/bootstrap.ts",
    "./src/worker.ts",
    "./dist/bootstrap.js",
    "./dist/worker.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bootstrap": {
      "@isoloop/source": "./src/bootstrap.ts",
      "import": "./dist/bootstrap.js"
    },
    "./worker": {
      "@isoloop/source": "./src/worker.ts",
      "import": "./dist/worker.js"
    },
    "./testing": {
      "@isoloop/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./bootstrap": {
        "import": "./dist/bootstrap.js"
      },
      "./worker": {
        "import": "./dist/worker.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/dom": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
