{
  "name": "@isoloop/bus",
  "version": "0.2.0-next.0",
  "description": "The Isoloop message bus: typed topics in a worker, with retention, replay and durable history.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "message-bus",
    "pubsub",
    "event-log",
    "replay"
  ],
  "homepage": "https://isoloop.dev/docs/api/bus/",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/bus-worker.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/bus"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "@isoloop/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./worker": {
      "@isoloop/source": "./src/worker.ts",
      "import": "./dist/bus-worker.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./worker": {
        "import": "./dist/bus-worker.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/codec": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  }
}
