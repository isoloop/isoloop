{
  "name": "@isoloop/devtools",
  "version": "0.1.1",
  "description": "Experimental devtools panel for Isoloop: shows isolates, pools, the message bus and live records, from an isolate of its own.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "devtools"
  ],
  "homepage": "https://isoloop.dev/docs/api/devtools/",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/panel.tsx",
    "./dist/panel.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panel": {
      "@isoloop/source": "./src/panel.tsx",
      "import": "./dist/panel.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./panel": {
        "import": "./dist/panel.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/host": "workspace:*"
  },
  "devDependencies": {
    "@isoloop/preact": "workspace:*",
    "@isoloop/protocol": "workspace:*",
    "@isoloop/runtime": "workspace:*",
    "typescript": "catalog:"
  }
}
