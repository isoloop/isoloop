{
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": {
    // The CLI runs in Node (>= 26).
    "lib": ["ES2023"],
    "types": ["node"],
    // A bin with no exports: it publishes no .d.ts, so the fixtures (contracts
    // modules as apps write them) needn't carry explicit types.
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["src"],
  // Codemod fixtures are users' code before and after a step, old APIs
  // included, so they aren't compiled.
  "exclude": ["src/migrate/*/fixtures"]
}
