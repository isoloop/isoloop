{
  "name": "isoloop",
  "version": "0.1.1",
  "description": "The Isoloop command line: export contracts as JSON Schema, run the dev MCP server for coding agents, and add the agent skill.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "cli",
    "mcp",
    "json-schema"
  ],
  "homepage": "https://isoloop.dev/docs/api/cli/",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/cli"
  },
  "bin": {
    "isoloop": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --platform node --no-dts --no-fixed-extension && node -e \"require('node:fs').cpSync('../../skills', 'dist/skills', { recursive: true })\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/bus": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
