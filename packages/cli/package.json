{
  "name": "isoloop",
  "version": "0.1.0-next.3",
  "description": "The Isoloop command line: export contracts as JSON Schema, run the dev MCP server, and later add the agent skill.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/cli"
  },
  "bin": {
    "isoloop": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --platform node --no-dts --no-fixed-extension",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/bus": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
