{
  "name": "@isoloop/host",
  "version": "0.0.0",
  "description": "Main-thread kernel: loads, supervises and composites isolates.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/host"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown --platform browser --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/dom": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
