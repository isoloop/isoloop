{
  "name": "@isoloop/host",
  "version": "0.1.0-next.12",
  "description": "The Isoloop kernel: runs the parts of a JavaScript app as isolates, on their own workers or in shared pools, and restarts what fails.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "supervisor",
    "fault-isolation",
    "microfrontends"
  ],
  "homepage": "https://isoloop.dev/docs/api/host/",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/host"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev-mcp": {
      "@isoloop/source": "./src/dev-mcp.ts",
      "types": "./dist/dev-mcp.d.ts",
      "import": "./dist/dev-mcp.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./dev-mcp": {
        "types": "./dist/dev-mcp.d.ts",
        "import": "./dist/dev-mcp.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/dev-mcp.ts --platform browser --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isoloop/dom": "workspace:*",
    "@isoloop/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
