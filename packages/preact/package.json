{
  "name": "@isoloop/preact",
  "version": "0.1.0-next.12",
  "description": "Preact for Isoloop: run a component as an isolate in a worker, with hooks for the message bus and the host.",
  "keywords": [
    "isoloop",
    "web-workers",
    "event-loop",
    "isolation",
    "preact",
    "microfrontends"
  ],
  "homepage": "https://isoloop.dev/docs/api/preact/",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isoloop/isoloop.git",
    "directory": "packages/preact"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@isoloop/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10 || ^11"
  },
  "dependencies": {
    "@isoloop/protocol": "workspace:*",
    "@isoloop/runtime": "workspace:*"
  },
  "devDependencies": {
    "@isoloop/dom": "workspace:*",
    "preact10": "catalog:",
    "preact11": "catalog:",
    "typescript": "catalog:"
  }
}
