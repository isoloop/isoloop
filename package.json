{
  "name": "isoloop-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project protocol --project bus",
    "test:browser": "vitest run --project dom --project host --project runtime",
    "e2e": "playwright test",
    "bench": "vitest run --config bench/vitest.config.ts",
    "test:install-browsers": "playwright install chromium firefox webkit",
    "build": "pnpm -r build",
    "dev": "pnpm --filter four-loops dev",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
