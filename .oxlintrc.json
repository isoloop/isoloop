{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // ADR 0009, rule 5: every rule is an error or off; type-aware on every run.
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  // oxlint's defaults, plus `import` for import/no-cycle (ADR 0021, decision 8).
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  // Type-aware rules outside the categories above, added by name: promise
  // handling, `any` leaking out of message payloads, and exhaustive switches
  // over message unions.
  "rules": {
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error",
    // For window.postMessage. Isoloop posts to workers and ports, which take no
    // targetOrigin, so every hit would be a false positive.
    "unicorn/require-post-message-target-origin": "off",
    // The E2E test hook e2e/loops.ts puts on window (invariant I7).
    "no-underscore-dangle": ["error", { "allow": ["__isoloop"] }],
    // The source layout (ADR 0021, decision 8): no import cycles, and file
    // names in kebab-case. The layout test (scripts/layout) checks the rest.
    "import/no-cycle": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    // Three of the import plugin's category rules misread code written on
    // purpose: Vite's `?worker` modules have a default export the rule can't
    // see (import/default); `fc.assert` is fast-check's documented style
    // (no-named-as-default-member); bootstraps and type-only harness files are
    // imported for their side effects (no-unassigned-import).
    "import/default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off"
  },
  // Dependency rules (system design §2). Each package lists the @isoloop/*
  // packages it may import; everything else under the scope is an error.
  // pnpm's strict node_modules covers third-party packages.
  "overrides": [
    {
      "files": ["packages/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "protocol depends on nothing (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/codec/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "codec depends on nothing (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/bus/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/codec"],
                "message": "bus may only import protocol and codec (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/balancer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/host"],
                "message": "balancer works on the kernel's public API, through its own KernelLike; it may import host's types only (M3h)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol"],
                "message": "host may only import protocol, and @isoloop/dom/host only in render/isoloop-dom.ts, the bridge the compositor drives (invariant I1); it loads bus and runtime bundles by URL (system design §2, ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/src/render/isoloop-dom.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/dom/host"],
                "message": "the bridge may import protocol and @isoloop/dom/host only (ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/dom/worker"],
                "message": "runtime may only import protocol and @isoloop/dom/worker (system design §2, ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/preact/**", "packages/react/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/runtime"],
                "message": "adapters may only import runtime and protocol, never dom or host (system design §2, ADR 0010)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/preact/src/**/*.test.*",
        "packages/react/src/**/*.test.*",
        "packages/preact/src/__fixtures__/**",
        "packages/react/src/__fixtures__/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@isoloop/**",
                  "!@isoloop/protocol",
                  "!@isoloop/runtime",
                  "!@isoloop/runtime/testing",
                  "!@isoloop/runtime/bootstrap",
                  "!@isoloop/dom/worker",
                  "!@isoloop/dom/testing",
                  "!@isoloop/dom/testing/worker"
                ],
                "message": "adapter tests and fixtures may also use the DOM subset and its test tools (M3a task 2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/bus", "!@isoloop/protocol"],
                "message": "the CLI runs in Node: it uses the bus's contracts and JSON Schema helpers and the protocol's dev MCP wire (M4a tasks 5 and 6), never the browser packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/devtools/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/host"],
                "message": "the devtools mount runs on the main thread: it may import host only, never runtime or bus (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      // The panel: a visual isolate, drawn in a worker.
      "files": [
        "packages/devtools/src/panel.tsx",
        "packages/devtools/src/views.tsx",
        "packages/devtools/src/bus-view.tsx",
        "packages/devtools/src/messages-view.tsx",
        "packages/devtools/src/events-view.tsx",
        "packages/devtools/src/record-detail.tsx",
        "packages/devtools/src/subtabs.tsx",
        "packages/devtools/src/event-level.ts",
        "packages/devtools/src/event-level.test.ts",
        "packages/devtools/src/event-store.ts",
        "packages/devtools/src/event-store.test.ts",
        "packages/devtools/src/format.ts",
        "packages/devtools/src/format.test.ts",
        "packages/devtools/src/ring.ts",
        "packages/devtools/src/feed.ts",
        "packages/devtools/src/persist.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@isoloop/**",
                  "!@isoloop/preact",
                  "!@isoloop/runtime",
                  "!@isoloop/protocol"
                ],
                "message": "the devtools panel is an isolate: it may import preact, runtime and protocol's types, never host or bus (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/webmcp/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/host"],
                "message": "webmcp runs on the main thread on the kernel's public API: it may import host only, never runtime or bus (system design §2, ADR 0018)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/vite/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "the Vite plugin imports no Isoloop package; it names the worker entries for Vite to resolve in the app (M3a task 15)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@isoloop/**",
                  "!@isoloop/protocol",
                  "!@isoloop/dom/host",
                  "!@isoloop/dom/testing"
                ],
                "message": "host tests may also import @isoloop/dom/testing (ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "dom imports no other @isoloop package (ADR 0011 point 3)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../*"],
                "message": "src/shared imports nothing outside itself (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/worker/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../host/*", "../testing/*"],
                "message": "src/worker may import src/shared only: no DOM types, no host half (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/host/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../worker/*", "../testing/*"],
                "message": "src/host may import src/shared only (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    },
    {
      // App code as the dev MCP guard sees it (M4a task 7): it imports
      // @isoloop/host/dev-mcp, whose types resolve only once host is built.
      "files": ["packages/vite/src/__fixtures__/dev-mcp/**"],
      "rules": {
        "no-restricted-imports": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "docs/diagrams/viewer-*.js",
    "docs/diagrams/*.mjs",
    "scripts/docs/fence-app/**"
  ]
}
