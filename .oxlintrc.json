{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // ADR 0009, rule 5: every rule is an error or off; type-aware on every run.
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  // Type-aware rules outside the categories above, added by name: promise
  // handling, `any` leaking out of message payloads, and exhaustive switches
  // over message unions.
  "rules": {
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-deprecated": "error",
    // For window.postMessage. Isoloop posts to workers and ports, which take no
    // targetOrigin, so every hit would be a false positive.
    "unicorn/require-post-message-target-origin": "off",
    // The E2E test hook four-loops puts on window (invariant I7).
    "no-underscore-dangle": ["error", { "allow": ["__isoloop"] }]
  },
  // Dependency rules (system design §2). Each package lists the @isoloop/*
  // packages it may import; everything else under the scope is an error.
  // pnpm's strict node_modules covers third-party packages.
  "overrides": [
    {
      "files": ["packages/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "protocol depends on nothing (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/codec/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "codec depends on nothing (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/bus/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/codec"],
                "message": "bus may only import protocol and codec (system design §2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol"],
                "message": "host may only import protocol, and @isoloop/dom/host only in render/isoloop-dom.ts, the bridge the compositor drives (invariant I1); it loads bus and runtime bundles by URL (system design §2, ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/src/render/isoloop-dom.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/dom/host"],
                "message": "the bridge may import protocol and @isoloop/dom/host only (ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/dom/worker"],
                "message": "runtime may only import protocol and @isoloop/dom/worker (system design §2, ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/preact/**", "packages/react/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "!@isoloop/protocol", "!@isoloop/runtime"],
                "message": "adapters may only import runtime and protocol, never dom or host (system design §2, ADR 0010)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/preact/src/**/*.test.*",
        "packages/react/src/**/*.test.*",
        "packages/preact/src/__fixtures__/**",
        "packages/react/src/__fixtures__/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@isoloop/**",
                  "!@isoloop/protocol",
                  "!@isoloop/runtime",
                  "!@isoloop/runtime/testing",
                  "!@isoloop/dom/worker",
                  "!@isoloop/dom/testing",
                  "!@isoloop/dom/testing/worker"
                ],
                "message": "adapter tests and fixtures may also use the DOM subset and its test tools (M3a task 2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/vite/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "the Vite plugin imports no Isoloop package; it names the worker entries for Vite to resolve in the app (M3a task 15)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/host/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@isoloop/**",
                  "!@isoloop/protocol",
                  "!@isoloop/dom/host",
                  "!@isoloop/dom/testing"
                ],
                "message": "host tests may also import @isoloop/dom/testing (ADR 0011)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**"],
                "message": "dom imports no other @isoloop package (ADR 0011 point 3)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../*"],
                "message": "src/shared imports nothing outside itself (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/worker/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../host/*", "../testing/*"],
                "message": "src/worker may import src/shared only: no DOM types, no host half (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dom/src/host/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@isoloop/**", "../worker/*", "../testing/*"],
                "message": "src/host may import src/shared only (ADR 0011 point 5)."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**"]
}
