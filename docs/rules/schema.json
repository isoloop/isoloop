{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isoloop/isoloop/blob/main/docs/rules/schema.json",
  "title": "A concept's rules (ADR 0026)",
  "description": "Editor hints only: scripts/rules/check.ts does the validation.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "statement", "status", "events"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": ["active", "decided", "proposed", "withdrawn", "rejected", "superseded"]
      },
      "experimental": {
        "type": "boolean"
      },
      "values": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "knob": {
        "type": "string",
        "minLength": 1
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "code": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "since": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
      },
      "target": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "supersededBy": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "events": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "date", "ref", "why"],
          "properties": {
            "type": {
              "enum": [
                "proposed",
                "decided",
                "clarified",
                "amended",
                "built",
                "shipped",
                "corrected",
                "reopened",
                "removed",
                "rejected",
                "withdrawn",
                "superseded"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "ref": {
              "type": "string",
              "description": "adr/NNNN#heading-anchor, #N or repo#N (a PR or an issue), or vX.Y.Z (a release tag)",
              "pattern": "^(adr/\\d{4}(#[a-z0-9_-]+)?|([a-z][a-z0-9-]*)?#\\d+|v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?)$"
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "prev": {
              "type": "string",
              "minLength": 1,
              "description": "The wording or behaviour before; required on clarified and amended"
            }
          }
        }
      }
    }
  }
}
