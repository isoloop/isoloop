  "cards": [
    {
      "dot": "rose",
      "title": "One-for-one, for an own worker",
      "items": [
        "Only isolate C restarts; every other isolate keeps running and painting.",
        "Backoff 250 ms × 2ⁿ, at most 4 s; a 4th crash within 60 s fails it with a fallback."
      ]
    },
    {
      "dot": "emerald",
      "title": "Why replay works",
      "items": [
        "Offsets belong to the consumer (the isolate id or its group), not to the worker.",
        "Commits go out at most once per commit interval, so a crash can redeliver up to that interval: handlers must be idempotent.",
        "Persistent topics also replay this way across a page reload."
      ]
    }
  ]
