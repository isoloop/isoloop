  "cards": [
    {
      "dot": "amber",
      "title": "Whose fault decides",
      "items": [
        "A member's own fatal error, ready timeout or version mismatch is its own: it restarts alone, back into the running worker.",
        "A missed heartbeat or a worker error is the worker's: every member crashes and they restart together in a new worker.",
        "A handler that throws is not a crash: it reports isolate:error and stops that subscription's commits."
      ]
    },
    {
      "dot": "emerald",
      "title": "Replay is per member",
      "items": [
        "Each member keeps its own bus port, subscriptions and committed offsets, so each replays from its own commits.",
        "Up to one commit interval of handled records can come back; persistent topics also replay across a page reload."
      ]
    }
  ]
