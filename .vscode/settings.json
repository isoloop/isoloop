{
  // TypeScript 7 from the workspace (ADR 0009). TS 7 ships no tsserver.js, so the
  // old `typescript.tsdk` doesn't apply: the TypeScript 7 extension reads
  // `js/ts.tsdk.path` and is switched on by `js/ts.experimental.useTsgo`.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "node_modules/typescript",

  // oxc: oxfmt formats, oxlint lints. Both read their config from the repo root.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // Editor hints for the rules registry (ADR 0026); `archeion check` validates.
  "json.schemas": [
    {
      "fileMatch": [
        ".archeion/rules/*.json",
        "!.archeion/rules/concepts.json",
        "!.archeion/rules/keywords.json",
        "!.archeion/rules/schema.json"
      ],
      "url": "./.archeion/rules/schema.json"
    }
  ],
  "[markdown]": {
    // Docs aren't formatted (.oxfmtrc.json ignores *.md).
    "editor.formatOnSave": false
  }
}
